# ============================================
# FounderGPT - Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================
# OpenAI Configuration
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Supabase Configuration
# ============================================
# Get these from your Supabase project dashboard: https://app.supabase.com
# Project Settings > API

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (safe for client-side use)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdC1pZCIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNjY4NjA4MDAwLCJleHAiOjIwODM0MDQwMDB9.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Service Role Key (SECRET - backend only, never expose to client)
# This key bypasses RLS - keep it secure!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdC1pZCIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE2Njg2MDgwMDAsImV4cCI6MjA4MzQwNDAwMH0.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Direct PostgreSQL Connection (Optional - for advanced use)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
# SUPABASE_DB_URL=postgresql://postgres:xxxxxxxxxxxx@db.your-project-id.supabase.co:5432/postgres

# ============================================
# Llama Parse Configuration (OPTIONAL)
# ============================================
# ⚠️ NOT REQUIRED - System works with just OpenAI API key
# Get your API key from: https://cloud.llamaindex.ai/
# Used for advanced document parsing (better than basic readers)
# If not provided, falls back to basic PDFReader/DocxReader (still functional)
# Recommendation: Skip if you have simple documents or want to reduce costs
# Set ENABLE_LLAMA_PARSE=false if not using
LLAMA_CLOUD_API_KEY=
ENABLE_LLAMA_PARSE=false

# ============================================
# Application Configuration
# ============================================
# Environment: development | staging | production
ENV=development

# Backend server port
PORT=8000

# Application name
PROJECT_NAME=FounderGPT API

# ============================================
# Security Configuration
# ============================================
# Allowed email domains for authentication (comma-separated)
# Only users from these domains can access the platform
ALLOWED_EMAIL_DOMAINS=@silambarasantr.com

# CORS origins (comma-separated)
# For development: http://localhost:3000
# For production: https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================
# Storage Configuration
# ============================================
# Supabase Storage bucket name for documents
STORAGE_BUCKET_NAME=GPTv1

# Maximum file upload size (in bytes)
# Default: 10MB = 10485760
MAX_UPLOAD_SIZE=10485760

# ============================================
# AI Model Configuration
# ============================================
# OpenAI model for chat completions
# Options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
OPENAI_MODEL=gpt-4

# OpenAI embedding model
# Options: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ============================================
# RAG Configuration
# ============================================
# Default number of chunks to retrieve per query
# Recommended: 5-10 for small docs, 10-15 for large docs (50+ pages)
RAG_CHUNK_LIMIT=10

# Chunk size for document splitting (characters)
# Recommended: 1024 for small docs, 2048 for large docs (50+ pages), 3072 for very large
CHUNK_SIZE=2048

# Chunk overlap for document splitting (characters)
# Recommended: 100-200 for better continuity, especially for large documents
CHUNK_OVERLAP=200

# Similarity search threshold (0-1)
# Lower = more strict (fewer results), Higher = more lenient (more results)
# Recommended: 0.7 for balanced results
SIMILARITY_THRESHOLD=0.7

# ============================================
# Logging Configuration
# ============================================
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Enable conversation logging for analytics
ENABLE_CONVERSATION_LOGGING=true

# ============================================
# Production Configuration
# ============================================
# Frontend URL (for production deployment)
# Used for CORS and redirects
FRONTEND_URL=http://localhost:3000

# API Base URL (for production)
# Used in frontend API calls
API_BASE_URL=http://localhost:8000/api/v1

# ============================================
# Feature Flags
# ============================================
# Enable document generation
ENABLE_DOCUMENT_GENERATION=true

# Enable streaming responses
ENABLE_STREAMING=true

# Enable advanced document parsing (Llama Parse)
ENABLE_LLAMA_PARSE=true

# Enable citation highlighting
ENABLE_CITATION_HIGHLIGHTING=true

# Enable conversation analytics
ENABLE_ANALYTICS=true

